{
  "name": "nightlife-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:demo": "dotenv -v NEXT_PUBLIC_APP_MODE=demo -- next dev -p 3001",
    "dev:live": "dotenv -e .env -- next dev",
    "dev:pglite": "tsx scripts/pglite-dev.ts",
    "dev:pglite:seed": "tsx scripts/pglite-dev.ts --seed",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:migrate": "dotenv -e .env -- npx prisma migrate deploy",
    "db:seed": "dotenv -e .env -- npx tsx prisma/seed.ts",
    "db:seed:staging": "dotenv -e .env -- npx tsx prisma/seed-staging.ts",
    "db:seed:live-history": "dotenv -e .env -- npx tsx scripts/seed-live-history.ts",
    "promo:screenshots": "tsx promo-main/scripts/promo-screenshots.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.9.1",
    "resend": "^6.18.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@electric-sql/pglite-socket": "^0.1.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
