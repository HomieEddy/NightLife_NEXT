{
  "name": "nightlife-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:demo": "dotenv -v NEXT_PUBLIC_APP_MODE=demo -- next dev -p 3001",
    "dev:live": "dotenv -e .env -- next dev",
    "dev:pglite": "tsx scripts/pglite-dev.ts",
    "dev:pglite:seed": "tsx scripts/pglite-dev.ts --seed",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:migrate": "dotenv -e .env -- npx prisma migrate deploy",
    "db:seed": "dotenv -e .env -- npx tsx prisma/seed.ts",
    "db:seed:staging": "dotenv -e .env -- npx tsx prisma/seed-staging.ts",
    "db:seed:live-history": "dotenv -e .env -- npx tsx scripts/seed-live-history.ts",
    "db:privacy-erase": "dotenv -e .env -- npx tsx scripts/privacy-erase.ts",
    "promo:env": "tsx promo-main/env/promo-env.ts",
    "promo:capture": "tsx promo-main/capture/run.ts",
    "promo:studio": "npm --prefix promo-main run studio",
    "promo:render": "npm --prefix promo-main run render --",
    "promo:screenshots": "tsx promo-main/capture/screenshots.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.5.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.6.23",
    "bullmq": "^5.81.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.23.0",
    "next": "16.3.0",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-email": "^6.9.1",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "resend": "^6.18.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@electric-sql/pglite-socket": "^0.1.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.3",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
