# App mode: "demo" (default) or "live"
# Unset or "demo" boots the sandbox with no DB needed.
# NEXT_PUBLIC_APP_MODE=live

# Counterpart deployment links (two Vercel projects from this repository)
# NEXT_PUBLIC_LIVE_URL=https://www.example.com
# NEXT_PUBLIC_DEMO_URL=https://demo.example.com

# Required in live mode only
DATABASE_URL="postgresql://nightlife:nightlife@localhost:5432/nightlife"

# Redis (BullMQ queue — optional, cron fallback when absent)
# REDIS_URL=redis://localhost:6379

# Session secret — at least 32 chars (required in live mode)
# AUTH_SECRET="generate-a-random-secret-here"

# QR token HMAC secret — distinct from AUTH_SECRET (required in live mode)
# QR_TOKEN_SECRET="generate-a-different-secret-here"

# Better Auth URL (defaults to NEXT_PUBLIC_APP_URL)
# BETTER_AUTH_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email notifications (plan 25) — Resend
# EMAIL_DRIVER=log  # default: logs to stdout, no API key needed
# EMAIL_DRIVER=resend  # real sends, requires RESEND_API_KEY
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM="NightLife <noreply@nightlife.app>"

# Cron job secret (plan 25) — bearer token for /api/jobs/* endpoints
# CRON_SECRET=generate-a-random-secret-for-cron-jobs

# SMS notifications (plan 26) — Twilio
# SMS_DRIVER=log  # default: logs to stdout, no API key needed
# SMS_DRIVER=twilio  # real sends, requires TWILIO_* vars
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM=+15145550123

# Web Push notifications (plan 28) — Web Push API + VAPID
# Generate: npx web-push generate-vapid-keys
# PUSH_DRIVER=log  # default: logs to stdout, no keys needed
# PUSH_DRIVER=webpush  # real push delivery, requires VAPID_* vars
# NEXT_PUBLIC_VAPID_KEY=your_vapid_public_key
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:noreply@nightlife.app
