# App mode: "demo" (default) or "live"
# Unset or "demo" boots the sandbox with no DB needed.
# NEXT_PUBLIC_APP_MODE=live

# Counterpart deployment links (two Vercel projects from this repository)
# NEXT_PUBLIC_LIVE_URL=https://www.example.com
# NEXT_PUBLIC_DEMO_URL=https://demo.example.com

# Required in live mode only
DATABASE_URL="postgresql://nightlife:nightlife@localhost:5432/nightlife"

# Session secret — at least 32 chars (required in live mode)
# AUTH_SECRET="generate-a-random-secret-here"

# QR token HMAC secret — distinct from AUTH_SECRET (required in live mode)
# QR_TOKEN_SECRET="generate-a-different-secret-here"

# Better Auth URL (defaults to NEXT_PUBLIC_APP_URL)
# BETTER_AUTH_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
