# App mode: "demo" (default) or "live"
# Unset or "demo" boots the sandbox with no DB needed.
# NEXT_PUBLIC_APP_MODE=live

# Required in live mode only
DATABASE_URL="postgresql://nightlife:nightlife@localhost:5432/nightlife"

# Session secret — at least 32 chars (required in live mode)
# AUTH_SECRET="generate-a-random-secret-here"

# Better Auth URL (defaults to NEXT_PUBLIC_APP_URL)
# BETTER_AUTH_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
