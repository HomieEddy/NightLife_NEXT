# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# PGlite local dev database
/.pglite-data/

# promo screenshot output
/promo-output/

# Remotion project (standalone video toolchain)
promo-video/out/          # rendered .mp4 files
promo-video/.remotion/    # Remotion cache
promo-video/public/music/ # large audio files

# next.js
/.next/
/.next-demo/
/.next-live/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent config / local tooling
.claude/
AGENTS.md
CLAUDE.md
PROMO.md

.vercel
