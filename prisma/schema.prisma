generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Platform tenant — one per venue. Platform context (unscoped).
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("starter")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  jobRuns JobRun[]

  @@map("tenants")
}

/// Background job execution log (AD-9). Platform context.
model JobRun {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  jobName   String    @map("job_name")
  status    String    @default("pending")
  payload   Json?
  result    Json?
  error     String?
  startedAt DateTime? @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, jobName])
  @@map("job_runs")
}

// ── Better Auth core tables ─────────────────────────────────────────

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  role            String?
  banned          Boolean?
  banReason       String?   @map("ban_reason")
  banExpires      DateTime? @map("ban_expires") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  staffProfile  StaffProfile?

  @@map("users")
}

model Session {
  id                   String    @id
  userId               String    @map("user_id")
  token                String    @unique
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz
  ipAddress            String?   @map("ip_address")
  userAgent            String?   @map("user_agent")
  impersonatedBy       String?   @map("impersonated_by")
  activeOrganizationId String?   @map("active_organization_id")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("verifications")
}

// ── Organization plugin tables ──────────────────────────────────────
// Organization = venue (1:1 with Tenant). Member roles = StaffRole.

model Organization {
  id        String    @id
  name      String
  slug      String    @unique
  logo      String?
  metadata  String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  members     Member[]
  invitations Invitation[]
  venue       Venue?

  @@map("organizations")
}

model Member {
  id             String   @id
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("members")
}

model Invitation {
  id             String   @id
  email          String
  inviterId      String   @map("inviter_id")
  organizationId String   @map("organization_id")
  role           String
  status         String   @default("pending")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

// ── Domain extension ────────────────────────────────────────────────
// Venue-domain fields that don't belong in the auth User model.

model StaffProfile {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  phone           String   @default("")
  avatarInitials  String   @map("avatar_initials")
  assignedZoneIds String[] @default([]) @map("assigned_zone_ids")
  isOnShift       Boolean  @default(false) @map("is_on_shift")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

// ── Venue, zones & tables (plan 03) ─────────────────────────────────
// Venue shares its primary key with Organization (1:1) — name/slug stay
// on Organization, this table holds the rest of the config. JSONB columns
// are Zod-validated on write (src/server/schemas/venue.ts), not trusted on read.

model Venue {
  id                     String   @id
  address                String
  city                   String
  timezone               String
  currency               String   @default("USD")
  openingHours           Json     @map("opening_hours")
  serviceFees            Json     @map("service_fees")
  floorMap               Json     @map("floor_map")
  autoApproveGuests      Boolean  @default(false) @map("auto_approve_guests")
  logoInitials           String   @map("logo_initials")
  slaThresholds          Json     @map("sla_thresholds")
  lastCallAutoFlagTables Boolean  @default(true) @map("last_call_auto_flag_tables")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization    @relation(fields: [id], references: [id], onDelete: Cascade)
  zones          Zone[]
  tables         VenueTable[]
  shifts         StaffShift[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  packages       BottlePackage[]
  happyHourRules HappyHourRule[]
  stockMovements StockMovement[]
  soldOutEvents  SoldOutEvent[]

  @@map("venues")
}

/// tableCount is derived by count, never stored (DDD §4).
model Zone {
  id          String   @id @default(cuid())
  venueId     String   @map("venue_id")
  name        String
  description String   @default("")
  color       String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  venue  Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tables VenueTable[]

  @@index([venueId])
  @@map("zones")
}

enum TableStatus {
  open
  occupied
  reserved
  closed
}

model VenueTable {
  id           String      @id @default(cuid())
  venueId      String      @map("venue_id")
  zoneId       String      @map("zone_id")
  code         String
  label        String
  seats        Int
  minimumSpend Float?      @map("minimum_spend")
  status       TableStatus @default(open)
  qrSlug       String      @unique @map("qr_slug")
  mapX         Float?      @map("map_x")
  mapY         Float?      @map("map_y")
  /// Reserved for plan 06 (signed QR tokens) — bumped to invalidate old QR codes.
  tokenVersion Int         @default(0) @map("token_version")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([venueId])
  @@index([zoneId])
  @@map("venue_tables")
}

/// One recurring weekly shift block. staffId is unscoped by design — staff
/// identity CRUD stays mock until it migrates; no FK to enforce yet.
model StaffShift {
  id        String   @id @default(cuid())
  venueId   String   @map("venue_id")
  staffId   String   @map("staff_id")
  dayOfWeek Int      @map("day_of_week")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  zoneId    String?  @map("zone_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@map("staff_shifts")
}

// ── Menu, inventory & packages (plan 04) ──────────────────────────────

model MenuCategory {
  id          String   @id @default(cuid())
  venueId     String   @map("venue_id")
  name        String
  description String   @default("")
  sortOrder   Int      @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  venue Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([venueId])
  @@map("menu_categories")
}

model MenuItem {
  id             String   @id @default(cuid())
  venueId        String   @map("venue_id")
  categoryId     String   @map("category_id")
  name           String
  description    String   @default("")
  priceCents     Int      @map("price_cents")
  icon           String   @default("champagne")
  tags           String[] @default([])
  isAvailable    Boolean  @default(true) @map("is_available")
  /// Cached running balance — always updated inside the same transaction as a StockMovement row.
  inventory      Int      @default(0)
  modifierGroups Json     @default("[]") @map("modifier_groups")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  venue      Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category   MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements  StockMovement[]
  components PackageComponent[]

  @@index([venueId])
  @@index([categoryId])
  @@map("menu_items")
}

/// Append-only ledger — no UPDATE/DELETE in prod (DDD §6).
model StockMovement {
  id         String   @id @default(cuid())
  venueId    String   @map("venue_id")
  menuItemId String   @map("menu_item_id")
  itemName   String   @map("item_name")
  type       String
  delta      Int
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([menuItemId])
  @@map("stock_movements")
}

/// Logged the moment an item sells out or gets manually 86'd.
model SoldOutEvent {
  id       String   @id @default(cuid())
  venueId  String   @map("venue_id")
  itemId   String   @map("item_id")
  itemName String   @map("item_name")
  at       DateTime @default(now()) @db.Timestamptz

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@map("sold_out_events")
}

model BottlePackage {
  id          String   @id @default(cuid())
  venueId     String   @map("venue_id")
  name        String
  description String   @default("")
  priceCents  Int      @map("price_cents")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  venue      Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  components PackageComponent[]

  @@index([venueId])
  @@map("bottle_packages")
}

model PackageComponent {
  id        String @id @default(cuid())
  packageId String @map("package_id")
  itemId    String @map("item_id")
  quantity  Int

  package  BottlePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  menuItem MenuItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([packageId, itemId])
  @@map("package_components")
}

model HappyHourRule {
  id                   String   @id @default(cuid())
  venueId              String   @map("venue_id")
  name                 String
  daysOfWeek           Int[]    @map("days_of_week")
  startTime            String   @map("start_time")
  endTime              String   @map("end_time")
  discountPct          Int      @map("discount_pct")
  appliesToCategoryIds String[] @map("applies_to_category_ids")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@map("happy_hour_rules")
}
