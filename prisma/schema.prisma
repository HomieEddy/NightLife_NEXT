/// Append-only notification log (AD-8) — one row per delivery attempt.
/// Email/SMS/Push transports each write here; the log is the idempotency check.
model NotificationLog {
  id         String   @id @default(cuid())
  venueId    String   @map("venue_id")
  channel    String   // "email" | "sms" | "push"
  template   String   // e.g. "staff-invite", "reservation-confirmation"
  recipient  String   // email address or phone number
  status     String   @default("queued") // "queued" | "sent" | "failed"
  providerId String?  @map("provider_id") // Resend message ID, Twilio SID
  error      String?
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([venueId, channel])
  @@index([venueId, template])
  @@map("notification_logs")
}

/// Phase 5: Web Push subscription — one per user per device (AD-20).
/// Endpoint is unique; token rotation creates new row, marks old as expired.
model PushSubscription {
  id         String   @id @default(cuid())
  venueId    String   @map("venue_id")
  userId     String   @map("user_id")
  endpoint   String   @unique
  keys       Json     // { p256dh, auth }
  userAgent  String?  @map("user_agent")
  expired    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([venueId, userId])
  @@index([venueId, expired])
  @@map("push_subscriptions")
}

/// Phase 5: Notification preference — one row per (user, eventType, channel).
/// Per-user per-channel per-event booleans (AD-20, INV-N1).
model NotificationPreference {
  id        String   @id @default(cuid())
  venueId   String   @map("venue_id")
  userId    String   @map("user_id")
  eventType String   @map("event_type") // "OrderPlaced", "HelpRequested", etc.
  channel   String   // "push" | "email" | "sms"
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([venueId, userId, eventType, channel])
  @@index([venueId, userId])
  @@map("notification_preferences")
}

/// Quiet hours per user (AD-20, INV-N4).
model UserQuietHours {
  id        String   @id @default(cuid())
  venueId   String   @map("venue_id")
  userId    String   @map("user_id")
  startTime String   @map("start_time") // "HH:mm" in user's timezone
  endTime   String   @map("end_time")   // "HH:mm"
  timezone  String   @default("America/Toronto")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([venueId, userId])
  @@map("user_quiet_hours")
}

/// Phase 4: Automation rule — one row per automation a venue can enable/configure.
model AutomationRule {
  id         String   @id @default(cuid())
  venueId    String   @map("venue_id")
  code       String   // AutomationCode enum value
  label      String
  description String
  enabled    Boolean  @default(false)
  category   String   // "reservations" | "orders" | "inventory" | "vip" | "events" | "reports"
  config     Json     @default("{}")
  lastTriggeredAt DateTime? @map("last_triggered_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  executions AutomationExecution[]

  @@unique([venueId, code])
  @@index([venueId, category])
  @@index([venueId, enabled])
  @@map("automation_rules")
}

/// Phase 4: Automation execution log — append-only record of each automation run.
model AutomationExecution {
  id                String   @id @default(cuid())
  venueId           String   @map("venue_id")
  ruleId            String   @map("rule_id")
  code              String   // AutomationCode enum value (denormalized for queries)
  triggeredAt       DateTime @map("triggered_at") @db.Timestamptz
  result            String   // Human-readable summary
  actionApplied     Boolean  @default(false) @map("action_applied")
  affectedEntityIds String[] @map("affected_entity_ids")
  durationMs        Int      @default(0) @map("duration_ms")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  rule AutomationRule @relation(fields: [ruleId], references: [id])

  @@index([venueId, triggeredAt(sort: Desc)])
  @@index([ruleId])
  @@map("automation_executions")
}

